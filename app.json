{
  "expo": {
    "name": "BillSync",
    "slug": "billsync",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "billsync",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "android": {
      "package": "com.billsync.app",
      "adaptiveIcon": {
        "backgroundColor": "#0891b2"
      }
    },
    "ios": {
      "bundleIdentifier": "com.billsync.app",
      "supportsTablet": true
    },
    "experiments": {
      "baseUrl": "/bill-sync"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "name": "BillSync",
      "shortName": "BillSync",
      "lang": "th",
      "themeColor": "#0891b2",
      "backgroundColor": "#f8fafc",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-camera",
        {
          "cameraPermission": "อนุญาตให้ BillSync ใช้กล้องเพื่อถ่ายรูปบิล (รูปถูกประมวลผลในเครื่อง)"
        }
      ],
      "expo-sqlite",
      "expo-notifications"
    ]
  }
}
